# Django Environment Configuration
DEBUG=True
SECRET_KEY=django-insecure-bedding-store-key-super-secure-change-in-prod-xyz987
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# Database
# Default: sqlite:////tmp/db.sqlite3 for instant dev, or postgres://user:password@localhost:5432/bedding_db for Postgres
DATABASE_URL=sqlite:///db.sqlite3

# Cache & Celery
REDIS_URL=redis://127.0.0.1:6379/1
CELERY_BROKER_URL=redis://127.0.0.1:6379/0

# Store Settings
BRAND_NAME=BeddingOrchid
STORE_DOMAIN=localhost:8000
STORE_CURRENCY=PKR
DEFAULT_SHIPPING_FEE=250.00
FREE_SHIPPING_THRESHOLD=4000.00
DEFAULT_COD_FEE=0.00

# Meta Ads Integration
META_PIXEL_ID=
META_CAPI_ACCESS_TOKEN=
META_TEST_EVENT_CODE=

# Email Settings
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=orders@beddingorchid.com
