[Unit]
Description=BeddingOrchid Gunicorn WSGI Application Service
After=network.target postgresql.service

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/var/www/beddingorchid
RuntimeDirectory=beddingorchid
Environment="HOME=/var/www/beddingorchid"
EnvironmentFile=-/var/www/beddingorchid/.env
ExecStart=/var/www/beddingorchid/.venv/bin/gunicorn \
    --workers 3 \
    --threads 2 \
    --worker-class gthread \
    --worker-tmp-dir /dev/shm \
    --bind unix:/run/beddingorchid/beddingorchid.sock \
    --umask 000 \
    --timeout 60 \
    --access-logfile - \
    --error-logfile - \
    config.wsgi:application

ExecReload=/bin/kill -s HUP $MAINPID
KillMode=mixed
TimeoutStopSec=15
PrivateTmp=true
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
