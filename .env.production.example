# ==============================================================================
# BeddingOrchid Production Environment Variables (.env)
# Path on VPS: /var/www/beddingorchid/.env
# Permissions: chmod 600 /var/www/beddingorchid/.env
# ==============================================================================

# Core Django Settings
DJANGO_SETTINGS_MODULE=config.settings.prod
DEBUG=False
SECRET_KEY=REPLACE_WITH_A_LONG_SECURE_RANDOM_SECRET_KEY

# Hosts & Domain Security (Crucial for HTTPS & Nginx)
ALLOWED_HOSTS=beddingorchid.com,www.beddingorchid.com,127.0.0.1,localhost
CSRF_TRUSTED_ORIGINS=https://beddingorchid.com,https://www.beddingorchid.com
STORE_DOMAIN=beddingorchid.com

# PostgreSQL Database (Dedicated for BeddingOrchid on Shared VPS)
# Format: postgres://USERNAME:PASSWORD@HOST:PORT/DB_NAME
DATABASE_URL=postgres://beddingorchid_user:YourStrongSecretPassword123!@localhost:5432/beddingorchid_db

# Redis & Celery (Dedicated DB indices e.g. 5 and 6 to avoid clashing with other VPS sites)
REDIS_URL=redis://127.0.0.1:6379/5
CELERY_BROKER_URL=redis://127.0.0.1:6379/6

# Store Identity & Defaults
BRAND_NAME=BeddingOrchid
STORE_CURRENCY=PKR
DEFAULT_SHIPPING_FEE=250.00
FREE_SHIPPING_THRESHOLD=4000.00
DEFAULT_COD_FEE=0.00

# Email Notifications (e.g. SMTP for order confirmations & customer alerts)
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=orders@beddingorchid.com
EMAIL_HOST_PASSWORD=YOUR_SMTP_APP_PASSWORD_HERE
DEFAULT_FROM_EMAIL=BeddingOrchid <orders@beddingorchid.com>

# Meta Ads / Pixel Tracking (Optional - enter when ready)
META_PIXEL_ID=
META_CAPI_ACCESS_TOKEN=
META_TEST_EVENT_CODE=

